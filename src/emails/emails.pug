include ../part-header.pug
	.section.width-max-readable.m-auto
		h1 💌 Emails
	.section.width-max-readable.m-auto.m-b-3
		#email-list-container.box.p-l-1.p-r-1.p-b-1.m-b-1
			h3 Email list
			p#email-list-loading-status Loading (requires multiple requests)...
			#email-list-wrapper.list-wrapper
				ul#email-list
		#email-editor-container.box.p-l-1.p-r-1.p-b-1.m-b-1
			h3 Edit email
			p.
				Editing an email with a new name will create a new email. Editing
				an email with an existing name will update the current email.
			p.m-b-0p3
				label Email name
				input#template-name.w-100.input
			div
				button#load-template-button.button.button.secondary Load Email With This Name
				#load-template-button-container
			p
				label Email subject
				input#template-subject.w-100.input
			p
				label Email type
				select#template-type.input.w-100
					option#template-type-wrapped-html(value='wrapped html') wrapped html
					option#template-type-full-html(value='full html') full html
			div
				#wrapped-html-editor
					p
						label
							input#show-html-editor(type="checkbox" checked)
							<span> </span>
							span Show HTML editor
					p
						button#insert-postal-address.button.secondary Insert postal address
						<span> </span>
						button#insert-unsubscribe-link.button.secondary Insert unsubscribe link
					#template-editor-wrapper.grid.left-1fr-right-1fr-m900
						#template-editor-rendered
							#template-editor
						#template-editor-html(style='min-height:10em;')
				#full-html-editor(style='display:none')
					p Full HTML email (starts with &lt;DOCTYPE...)
					textarea#full-html-editor-textarea.w-100.input(cols="30", rows="10")
					p Preview 
					iframe#full-html-preview.w-100(style="height:75vh;overflow:auto;border:1px solid grey;")
			div#content-alert
			p Text version of email
			.m-b-0p5
				button#generate-text-email-button.button.secondary Generate text from HTML
			textarea#template-text.input.w-100(rows="10")
			.m-t-1
				div
					label(for='test-email-recipient') Test email recipient
				div
					input.input.w-100(type="text" id='test-email-recipient' placeholder='test@example.org')
				#test-email-status
				.m-t-0p5
					label
						input(type='radio' id='send-test-as-template' name='send-test-type' checked value='template')
						span Send as template (make sure template is saved first)
					|
					|
					label
						input(type='radio' id='send-test-as-content' name='send-test-type' value='content')
						span Send as text/html content (don't need to save, but placeholders won't be replaced)
				.m-t-0p5
					button#send-test-email-button.button.secondary Send test email
			.m-t-1
				#create-template-output
				button#create-update-template-button.button.main Create/update email
include ../part-footer.pug
